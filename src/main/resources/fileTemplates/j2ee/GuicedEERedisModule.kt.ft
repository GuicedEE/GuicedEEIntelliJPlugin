package ${PACKAGE_NAME}

import com.guicedee.vertx.redis.RedisConnectionInfo
import com.guicedee.vertx.redis.RedisModule

open class ${NAME} : RedisModule<${NAME}>() {
    override fun getRedisConnectionInfo(): RedisConnectionInfo {
        val host = System.getProperty("REDIS_HOST",
                System.getenv().getOrDefault("REDIS_HOST", "${REDIS_HOST}"))
        val port = Integer.parseInt(System.getProperty("REDIS_PORT",
                System.getenv().getOrDefault("REDIS_PORT", "${REDIS_PORT}")))
        val database = Integer.parseInt(System.getProperty("REDIS_DATABASE",
                System.getenv().getOrDefault("REDIS_DATABASE", "${REDIS_DATABASE}")))

        return RedisConnectionInfo()
                .setName("${REDIS_NAME}")
                .setConnectionString("redis://" + host + ":" + port + "/" + database)
                .setMaxPoolSize(${MAX_POOL_SIZE})
                .setMaxWaitingHandlers(24)
                .setDefaultConnection(true)
        }
}
