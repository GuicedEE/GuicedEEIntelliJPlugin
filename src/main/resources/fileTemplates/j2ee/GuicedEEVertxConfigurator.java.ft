package ${PACKAGE_NAME};

import com.guicedee.vertx.spi.VertxConfigurator;
import io.vertx.core.VertxBuilder;
import io.vertx.core.VertxOptions;

/**
 * A Vertx configurator that configures Vertx options before initialization.
 */
public class ${NAME} implements VertxConfigurator {

    @Override
    public VertxOptions options(VertxOptions options) {
        // Customize shared options; preserve metrics, event-bus endpoints and pool sizes.
        return options;
    }

    @Override
    public VertxBuilder builder(VertxBuilder builder) {
        // Compose builder extensions without replacing shared VertxOptions.
        // GuicedEE's Hazelcast module supplies its own enabled cluster manager.
        return builder;
    }
}
